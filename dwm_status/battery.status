#!/bin/sh

bat=$(cat /sys/class/power_supply/BAT1/capacity 2>/dev/null)
ac_status=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)
( ([ $bat -gt 90 ] && ([ "$ac_status" = "1" ] && echo 󰂅 || echo 󰁹)) ||
  ([ $bat -gt 80 ] && ([ "$ac_status" = "1" ] && echo 󰂋 || echo 󰂂)) ||
  ([ $bat -gt 70 ] && ([ "$ac_status" = "1" ] && echo 󰂊 || echo 󰂁)) ||
  ([ $bat -gt 60 ] && ([ "$ac_status" = "1" ] && echo 󰢞 || echo 󰂀)) ||
  ([ $bat -gt 50 ] && ([ "$ac_status" = "1" ] && echo 󰂉 || echo 󰁿)) ||
  ([ $bat -gt 40 ] && ([ "$ac_status" = "1" ] && echo 󰢝 || echo 󰁾)) ||
  ([ $bat -gt 30 ] && ([ "$ac_status" = "1" ] && echo 󰂈 || echo 󰁽)) ||
  ([ $bat -gt 20 ] && ([ "$ac_status" = "1" ] && echo 󰂇 || echo 󰁼)) ||
  ([ $bat -gt 10 ] && ([ "$ac_status" = "1" ] && echo 󰂆 || echo 󰁻)) ||
  ([ "$ac_status" = "1" ] && echo 󰢜 ||echo 󰁺))
[ "$bat" = "" ] || echo "$bat%"
