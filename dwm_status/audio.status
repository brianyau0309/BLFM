#!/bin/sh

device="$(pulsemixer --list-sink 2>/dev/null | grep Default | grep " Built-in ")"
if [ -z "$device" ]; then
  echo 󰋋
fi

high() {
  echo 󰕾
}

medium() {
  echo 󰖀
}

low() {
  echo 󰕿
}

mute() {
  echo 󰝟
}

# pulseaudio
volumenum=$(pulsemixer --get-volume 2>/dev/null | cut -d' ' -f1)
if [ -z "$volumenum" ]; then
  echo ⚠
  exit
fi
[ $(pulsemixer --get-mute) -eq 1 ] &&
  mute ||
  ( ([ $volumenum -gt 49 ] && high) ||
    ([ $volumenum -gt 0 ] && medium) ||
    low)
